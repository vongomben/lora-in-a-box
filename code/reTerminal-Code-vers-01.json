    {
        "id": "a1f0c0de00000001",
        "type": "function",
        "z": "6282cda0d727e308",
        "name": "timestamp + filtro + log",
        "func": "// scarta valori mancanti (es. uplink di un altro device)\nif (typeof msg.payload !== 'number') return null;\nmsg.timestamp = Date.now();\nconst riga = { payload: JSON.stringify({ t: msg.timestamp, topic: msg.topic, v: msg.payload }) };\nreturn [msg, riga];",
