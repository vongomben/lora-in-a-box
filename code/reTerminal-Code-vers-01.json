    {
        "id": "fb680357f756b23c",
        "type": "function",
        "z": "6282cda0d727e308",
        "name": "function 3",
        "func": "const o = (msg.payload && msg.payload.object) || {};\n\n// Sensore CO2 / temperatura / umidità (S2103, codec custom)\nif (o.temperatura_C !== undefined || o.co2_ppm !== undefined) {\n    msg.payload = {\n        temperatura: o.temperatura_C,\n        umidita: o.umidita_pct,\n        co2: o.co2_ppm\n    };\n    return msg;\n}\n\n// Leafometer (S2100, codec ufficiale SenseCAP)\nif (Array.isArray(o.messages) && o.valid !== false) {\n    const misure = o.messages.flat().filter(m => m.type === \"Measurement\");\n    const out = {};\n    for (const m of misure) {\n        if (m.measurementId === 1) out.temperatura_foglia = m.measurementValue;\n        if (m.measurementId === 2) out.umidita_foglia = m.measurementValue;\n    }\n    if (Object.keys(out).length > 0) {\n        msg.payload = out;\n        return msg;\n    }\n}\n\n// tutto il resto (pacchetti informativi, errori) viene scartato\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 260,
