        "type": "function",
        "z": "6282cda0d727e308",
        "name": "rebuild points & data ",
        "func": "let d;\ntry { d = JSON.parse(msg.payload); } catch (e) { return null; }\n// il grafico tiene solo l'ultima ora: inutile reinviare dati più vecchi\nif (Date.now() - d.t > 3600 * 1000) return null;\nreturn { topic: d.topic, payload: d.v, timestamp: d.t };",
